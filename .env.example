# Settings read from the environment by src/config.py, with their defaults.
# Export the ones you change, for example: export NEO4J_PASSWORD=yourpassword
# (The code doesn't read a .env file itself.)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeThisPassword
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
